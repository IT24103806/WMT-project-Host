{
  "name": "salon-management-backend",
  "version": "1.0.0",
  "description": "Salon Management API with Node.js, Express, and MongoDB",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "tunnel": "lt --port 5000 --local-host 127.0.0.1 --subdomain salonmobilemendi",
    "tunnel:ssh": "ssh -o StrictHostKeyChecking=no -R 80:localhost:5000 nokey@localhost.run",
    "lint": "echo \"No lint configured\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2"
  }
}
